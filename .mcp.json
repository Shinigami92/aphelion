{
  "mcpServers": {
    "playwright": {
      "command": "pnpm",
      "args": [
        "exec",
        "playwright-mcp",
        "--browser",
        "chrome",
        "--viewport-size",
        "1680,1000",
        "--isolated",
        "--output-dir",
        ".playwright-mcp"
      ]
    }
  }
}
